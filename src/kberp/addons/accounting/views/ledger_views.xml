  <record id="view_move_list" model="core.ir_ui_view">
    <field name="name">accounting.move.list</field>
    <field name="model">accounting.move</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Journal Entries">
        <field name="name" string="Number"/>
        <field name="date" string="Date"/>
        <field name="journal_id" string="Journal"/>
        <field name="partner_id" string="Partner"/>
        <field name="amount_total" string="Total"/>
        <field name="secured" string="Secured"/>
        <field name="state" string="Status"/>
      </list>
    </field>
  </record>
  <record id="view_move_form" model="core.ir_ui_view">
    <field name="name">accounting.move.form</field>
    <field name="model">accounting.move</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Journal Entry">
        <header>
          <button name="action_post" string="Post" type="object"/>
          <button name="action_cancel" string="Cancel" type="object"/>
          <button name="action_reverse" string="Reverse" type="object"/>
          <button name="action_register_payment" string="Register Payment" type="object"/>
          <button name="action_credit_note" string="Credit Note" type="object"/>
          <button name="action_secure" string="Secure" type="object"/>
          <button name="action_send_followup" string="Follow Up" type="object"/>
          <button name="action_generate_etims" string="eTIMS" type="object"/>
          <button name="action_write_off" string="Write Off" type="object"/>
        </header>
        <sheet>
          <group string="Entry">
            <field name="state" widget="status"/>
            <field name="payment_state" string="Payment"/>
            <field name="journal_id"/>
            <field name="date"/>
            <field name="partner_id"/>
            <field name="move_type"/>
            <field name="due_date"/>
            <field name="currency_id"/>
            <field name="currency_rate"/>
            <field name="payment_term_id"/>
            <field name="fiscal_position_id"/>
            <field name="company_id"/>
            <field name="origin"/>
            <field name="secured" string="Secured"/>
          </group>
          <group string="Lines">
            <field name="line_ids" widget="lines">
              <list string="Lines" editable="1">
                <field name="account_id" string="Account"/>
                <field name="name" string="Label"/>
                <field name="product_id" string="Product"/>
                <field name="analytic_account_id" string="Analytic Account"/>
                <field name="tax_id" string="Tax"/>
                <field name="qty" string="Quantity"/>
                <field name="price_unit" string="Unit Price"/>
                <field name="tax_ids" string="Taxes"/>
                <field name="debit" string="Debit"/>
                <field name="credit" string="Credit"/>
              </list>
            </field>
          </group>
          <group string="Totals">
            <field name="amount_untaxed" string="Untaxed" readonly="1"/>
            <field name="amount_tax" string="Taxes" readonly="1"/>
            <field name="amount_total" string="Total" readonly="1"/>
            <field name="amount_residual" string="Residual" readonly="1"/>
            <field name="amount_debit" string="Debit" readonly="1"/>
            <field name="amount_credit" string="Credit" readonly="1"/>
          </group>
          <notebook>
            <page string="Notes">
              <group string="Internal Notes"><field name="note"/></group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_move_search" model="core.ir_ui_view">
    <field name="name">accounting.move.search</field>
    <field name="model">accounting.move</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Number"/>
        <field name="partner_id" string="Partner"/>
        <field name="origin" string="Source"/>
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
        <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
        <groupby name="journal_id" string="Journal"/>
        <groupby name="partner_id" string="Partner"/>
        <groupby name="state" string="Status"/>
      </search>
    </field>
  </record>
