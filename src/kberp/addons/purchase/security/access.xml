  <record id="access_purchase_landed_cost_line_user" model="core.ir_model_access">
    <field name="name">Landed Cost Line / Internal User: read</field>
    <field name="model">purchase.landed_cost_line</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_purchase_landed_cost_line_manager" model="core.ir_model_access">
    <field name="name">Landed Cost Line / Purchase Manager: full</field>
    <field name="model">purchase.landed_cost_line</field>
    <field name="group_xmlid">purchase.group_purchase_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>

  <record id="access_purchase_analysis_user" model="core.ir_model_access">
    <field name="name">Purchase Analysis / Internal User: read</field>
    <field name="model">purchase.analysis</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_purchase_analysis_manager" model="core.ir_model_access">
    <field name="name">Purchase Analysis / Purchase Manager: full</field>
    <field name="model">purchase.analysis</field>
    <field name="group_xmlid">purchase.group_purchase_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>

  <record id="access_purchase_analysis_line_user" model="core.ir_model_access">
    <field name="name">Purchase Analysis Row / Internal User: read</field>
    <field name="model">purchase.analysis_line</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_purchase_analysis_line_manager" model="core.ir_model_access">
    <field name="name">Purchase Analysis Row / Purchase Manager: full</field>
    <field name="model">purchase.analysis_line</field>
    <field name="group_xmlid">purchase.group_purchase_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>

</odoo>
