<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="group_purchase_user" model="core.res_groups">
    <field name="name">Purchase User</field>
  </record>
  <record id="group_purchase_manager" model="core.res_groups">
    <field name="name">Purchase Manager</field>
  </record>

  <record id="access_purchase_order_user" model="core.ir_model_access">
    <field name="name">Purchase Order / Internal User: read</field>
    <field name="model">purchase.order</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_purchase_order_line_user" model="core.ir_model_access">
    <field name="name">Purchase Line / Internal User: read</field>
    <field name="model">purchase.order_line</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_purchase_order_writer" model="core.ir_model_access">
    <field name="name">Purchase Order / Purchase User: write and create</field>
    <field name="model">purchase.order</field>
    <field name="group_xmlid">purchase.group_purchase_user</field>
    <field name="perm_write">True</field><field name="perm_create">True</field>
  </record>
  <record id="access_purchase_order_line_writer" model="core.ir_model_access">
    <field name="name">Purchase Line / Purchase User: write and create</field>
    <field name="model">purchase.order_line</field>
    <field name="group_xmlid">purchase.group_purchase_user</field>
    <field name="perm_write">True</field><field name="perm_create">True</field>
  </record>
  <record id="access_purchase_order_manager" model="core.ir_model_access">
    <field name="name">Purchase Order / Purchase Manager: full</field>
    <field name="model">purchase.order</field>
    <field name="group_xmlid">purchase.group_purchase_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>
  <record id="access_purchase_order_line_manager" model="core.ir_model_access">
    <field name="name">Purchase Line / Purchase Manager: full</field>
    <field name="model">purchase.order_line</field>
    <field name="group_xmlid">purchase.group_purchase_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>
  <record id="access_purchase_settings_user" model="core.ir_model_access">
    <field name="name">Purchase Settings / Internal User: read</field>
    <field name="model">purchase.settings</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_purchase_settings_manager" model="core.ir_model_access">
    <field name="name">Purchase Settings / Purchase Manager: full</field>
    <field name="model">purchase.settings</field>
    <field name="group_xmlid">purchase.group_purchase_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>
  <record id="access_vendor_price_user" model="core.ir_model_access">
    <field name="name">Vendor Price / Internal User: read</field>
    <field name="model">purchase.vendor_price</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_vendor_price_manager" model="core.ir_model_access">
    <field name="name">Vendor Price / Purchase Manager: full</field>
    <field name="model">purchase.vendor_price</field>
    <field name="group_xmlid">purchase.group_purchase_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>

  <record id="rule_purchase_order_company" model="core.ir_rule">
    <field name="name">Purchase orders: own company</field>
    <field name="model">purchase.order</field>
    <field name="domain">[["company_id", "in", "$company"]]</field>
    <field name="is_global">True</field>
  </record>


  <record id="access_purchase_agreement_user" model="core.ir_model_access">
    <field name="name">Purchase Agreement / Internal User: read</field>
    <field name="model">purchase.agreement</field>
