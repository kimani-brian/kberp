<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_sales_settings_list" model="core.ir_ui_view">
    <field name="name">sales.settings.list</field>
    <field name="model">sales.settings</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Sales Settings">
        <field name="name" string="Name"/>
        <field name="company_id" string="Company"/>
        <field name="validity_days" string="Quotation Validity (days)"/>
        <field name="invoice_policy" string="Invoicing Policy"/>
      </list>
    </field>
  </record>

  <record id="view_sales_settings_form" model="core.ir_ui_view">
    <field name="name">sales.settings.form</field>
    <field name="model">sales.settings</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Sales Settings">
        <sheet>
          <group string="Quotations">
            <field name="name"/>
            <field name="company_id"/>
            <field name="validity_days"/>
          </group>
          <group string="Invoicing">
            <field name="invoice_policy"/>
            <field name="allow_discount"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_sales_settings" model="core.ir_act_window">
    <field name="name">Settings</field>
    <field name="res_model">sales.settings</field>
    <field name="view_mode">list,form</field>
    <field name="path">sales/settings</field>
  </record>

</odoo>
