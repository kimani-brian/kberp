<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="group_sales_user" model="core.res_groups">
    <field name="name">Sales User</field>
  </record>
  <record id="group_sales_manager" model="core.res_groups">
    <field name="name">Sales Manager</field>
  </record>

  <record id="access_sale_order_user" model="core.ir_model_access">
    <field name="name">Quotation / Internal User: read</field>
    <field name="model">sales.order</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_sale_order_line_user" model="core.ir_model_access">
    <field name="name">Order Line / Internal User: read</field>
    <field name="model">sales.order_line</field>
    <field name="group_xmlid">base.group_user</field>
  </record>

  <record id="access_sale_order_writer" model="core.ir_model_access">
    <field name="name">Quotation / Sales User: write and create</field>
    <field name="model">sales.order</field>
    <field name="group_xmlid">sales.group_sales_user</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
  </record>
  <record id="access_sale_order_line_writer" model="core.ir_model_access">
    <field name="name">Order Line / Sales User: write and create</field>
    <field name="model">sales.order_line</field>
    <field name="group_xmlid">sales.group_sales_user</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
  </record>

  <record id="access_sale_order_manager" model="core.ir_model_access">
    <field name="name">Quotation / Sales Manager: full</field>
    <field name="model">sales.order</field>
    <field name="group_xmlid">sales.group_sales_manager</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
    <field name="perm_unlink">True</field>
  </record>
  <record id="access_sale_order_line_manager" model="core.ir_model_access">
    <field name="name">Order Line / Sales Manager: full</field>
    <field name="model">sales.order_line</field>
    <field name="group_xmlid">sales.group_sales_manager</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
    <field name="perm_unlink">True</field>
  </record>

  <record id="access_sales_settings_system" model="core.ir_model_access">
    <field name="name">Sales Settings / Settings: full</field>
    <field name="model">sales.settings</field>
    <field name="group_xmlid">base.group_system</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
    <field name="perm_unlink">True</field>
  </record>
  <record id="access_sales_settings_manager" model="core.ir_model_access">
    <field name="name">Sales Settings / Sales Manager: write</field>
    <field name="model">sales.settings</field>
    <field name="group_xmlid">sales.group_sales_manager</field>
    <field name="perm_write">True</field>
  </record>

  <record id="rule_sale_order_company" model="core.ir_rule">
    <field name="name">Quotations: own company</field>
    <field name="model">sales.order</field>
    <field name="domain">[["company_id", "in", "$company"]]</field>
    <field name="is_global">True</field>
  </record>


  <record id="access_sales_tag_user" model="core.ir_model_access">
    <field name="name">Sales Tag / Internal User: read</field>
    <field name="model">sales.tag</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_sales_tag_manager" model="core.ir_model_access">
    <field name="name">Sales Tag / Sales Manager: full</field>
    <field name="model">sales.tag</field>
    <field name="group_xmlid">sales.group_sales_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>
  <record id="access_header_footer_user" model="core.ir_model_access">
    <field name="name">Header / Internal User: read</field>
    <field name="model">sales.header_footer</field>
    <field name="group_xmlid">base.group_user</field>
  </record>
  <record id="access_header_footer_manager" model="core.ir_model_access">
    <field name="name">Header / Sales Manager: full</field>
    <field name="model">sales.header_footer</field>
    <field name="group_xmlid">sales.group_sales_manager</field>
    <field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
  </record>

</odoo>
