          <field name="parent_id"/><field name="warehouse_id"/>
          <field name="company_id"/><field name="active"/>
        </group>
      </sheet></form>
    </field>
  </record>
  <record id="action_location" model="core.ir_act_window">
    <field name="name">Locations</field>
    <field name="res_model">inventory.location</field>
    <field name="view_mode">list,form</field>
    <field name="path">inventory/locations</field>
  </record>

  <record id="view_operation_type_list" model="core.ir_ui_view">
    <field name="name">inventory.operation_type.list</field>
    <field name="model">inventory.operation_type</field>
