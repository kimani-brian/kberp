<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_picking_list" model="core.ir_ui_view">
    <field name="name">inventory.picking.list</field>
    <field name="model">inventory.picking</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Transfers">
        <field name="name" string="Number"/>
        <field name="partner_id" string="Partner"/>
        <field name="scheduled_date" string="Scheduled"/>
        <field name="source_location_id" string="From"/>
        <field name="dest_location_id" string="To"/>
        <field name="state" string="Status"/>
      </list>
    </field>
  </record>
  <record id="view_picking_form" model="core.ir_ui_view">
    <field name="name">inventory.picking.form</field>
    <field name="model">inventory.picking</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Transfer">
        <header>
          <button name="action_check" string="Check Availability" type="object"/>
          <button name="action_validate" string="Validate" type="object"/>
          <button name="action_cancel" string="Cancel" type="object"/>
        </header>
        <sheet>
          <group string="Transfer">
            <field name="state" widget="status"/>
            <field name="operation_type_id"/>
            <field name="partner_id"/>
            <field name="scheduled_date"/>
            <field name="source_location_id"/>
            <field name="dest_location_id"/>
            <field name="company_id"/>
            <field name="origin"/>
          </group>
          <group string="Operations">
            <field name="barcode_scan" widget="barcode"/>
            <field name="move_ids" widget="lines">
              <list string="Operations" editable="1">
                <field name="product_id" string="Product"/>
                <field name="name" string="Description"/>
                <field name="qty" string="Demand"/>
                <field name="done_qty" string="Done"/>
                <field name="uom_id" string="Unit"/>
                <field name="source_location_id" string="From"/>
                <field name="dest_location_id" string="To"/>
              </list>
            </field>
          </group>
          <notebook>
            <page string="Notes">
              <group string="Internal Notes"><field name="note"/></group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_picking_kanban" model="core.ir_ui_view">
    <field name="name">inventory.picking.kanban</field>
    <field name="model">inventory.picking</field>
    <field name="type">kanban</field>
    <field name="arch" type="xml">
      <kanban string="Transfers">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="scheduled_date"/>
        <field name="state"/>
      </kanban>
    </field>
  </record>
  <record id="view_picking_search" model="core.ir_ui_view">
    <field name="name">inventory.picking.search</field>
    <field name="model">inventory.picking</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Number"/>
        <field name="partner_id" string="Partner"/>
        <field name="origin" string="Source"/>
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="assigned" string="Ready" domain="[('state', '=', 'assigned')]"/>
        <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
        <groupby name="partner_id" string="Partner"/>
        <groupby name="state" string="Status"/>
      </search>
    </field>
  </record>
  <record id="action_receipt" model="core.ir_act_window">
    <field name="name">Receipts</field>
    <field name="res_model">inventory.picking</field>
    <field name="view_mode">list,kanban,form,search</field>
    <field name="domain">[('picking_type', '=', 'in')]</field>
    <field name="path">inventory/receipts</field>
  </record>
  <record id="action_delivery" model="core.ir_act_window">
    <field name="name">Deliveries</field>
    <field name="res_model">inventory.picking</field>
    <field name="view_mode">list,kanban,form,search</field>
    <field name="domain">[('picking_type', '=', 'out')]</field>
    <field name="path">inventory/deliveries</field>
  </record>
  <record id="action_internal" model="core.ir_act_window">
    <field name="name">Internal</field>
    <field name="res_model">inventory.picking</field>
    <field name="view_mode">list,kanban,form,search</field>
    <field name="domain">[('picking_type', '=', 'internal')]</field>
    <field name="path">inventory/internal</field>
  </record>
  <record id="action_transfer" model="core.ir_act_window">
    <field name="name">Transfers</field>
    <field name="res_model">inventory.picking</field>
    <field name="view_mode">list,kanban,form,search</field>
    <field name="path">inventory/transfers</field>
  </record>

  <record id="view_warehouse_list" model="core.ir_ui_view">
    <field name="name">inventory.warehouse.list</field>
    <field name="model">inventory.warehouse</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Warehouses">
        <field name="code" string="Code"/>
        <field name="name" string="Warehouse"/>
        <field name="stock_location_id" string="Stock Location"/>
      </list>
    </field>
  </record>
  <record id="view_warehouse_form" model="core.ir_ui_view">
    <field name="name">inventory.warehouse.form</field>
    <field name="model">inventory.warehouse</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Warehouse"><sheet>
        <group string="Warehouse">
          <field name="name"/><field name="code"/>
          <field name="stock_location_id"/><field name="company_id"/><field name="active"/>
        </group>
      </sheet></form>
    </field>
  </record>
  <record id="action_warehouse" model="core.ir_act_window">
    <field name="name">Warehouses</field>
    <field name="res_model">inventory.warehouse</field>
    <field name="view_mode">list,form</field>
    <field name="path">inventory/warehouses</field>
  </record>

  <record id="view_location_list" model="core.ir_ui_view">
    <field name="name">inventory.location.list</field>
    <field name="model">inventory.location</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Locations">
