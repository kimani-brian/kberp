<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_orderpoint_list" model="core.ir_ui_view">
    <field name="name">inventory.orderpoint.list</field>
    <field name="model">inventory.orderpoint</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Replenishment">
        <field name="name" string="Rule"/>
        <field name="product_id" string="Product"/>
        <field name="location_id" string="Location"/>
        <field name="min_qty" string="Min"/>
        <field name="max_qty" string="Max"/>
        <field name="last_rfq_id" string="Last RFQ"/>
      </list>
    </field>
  </record>
  <record id="view_orderpoint_form" model="core.ir_ui_view">
    <field name="name">inventory.orderpoint.form</field>
    <field name="model">inventory.orderpoint</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Reordering Rule">
        <header><button name="action_replenish" string="Run Now" type="object"/></header>
        <sheet>
          <group string="Rule">
            <field name="name"/><field name="product_id"/><field name="location_id"/>
            <field name="route_id"/><field name="min_qty"/><field name="max_qty"/>
            <field name="qty_multiple"/><field name="active"/><field name="last_rfq_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_orderpoint" model="core.ir_act_window">
    <field name="name">Replenishment</field>
    <field name="res_model">inventory.orderpoint</field>
    <field name="view_mode">list,form</field>
    <field name="path">inventory/replenishment</field>
  </record>

