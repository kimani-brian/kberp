<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Contact tags -->
  <record id="view_partner_tag_list" model="core.ir_ui_view">
    <field name="name">core.partner_tag.list</field>
    <field name="model">core.partner_tag</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Contact Tags">
        <field name="name" string="Tag"/>
        <field name="parent_id" string="Parent Tag"/>
        <field name="color" string="Color"/>
      </list>
    </field>
  </record>
  <record id="view_partner_tag_form" model="core.ir_ui_view">
    <field name="name">core.partner_tag.form</field>
    <field name="model">core.partner_tag</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Contact Tag">
        <sheet>
          <group string="Tag">
            <field name="name"/>
            <field name="parent_id"/>
            <field name="color"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_partner_tag_search" model="core.ir_ui_view">
    <field name="name">core.partner_tag.search</field>
    <field name="model">core.partner_tag</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Search"/>
        <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>
  <record id="action_partner_tag" model="core.ir_act_window">
    <field name="name">Contact Tags</field>
    <field name="res_model">core.partner_tag</field>
    <field name="view_mode">list,form,search</field>
    <field name="path">contact-tags</field>
  </record>

